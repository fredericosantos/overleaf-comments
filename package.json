{
  "name": "overleaf-comments",
  "displayName": "Overleaf Comments",
  "description": "Read Overleaf review comments inside VS Code for git-synced Overleaf projects.",
  "version": "0.0.1",
  "publisher": "fredericosantos",
  "license": "MIT",
  "private": true,
  "repository": "github:fredericosantos/overleaf-comments",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "overleafComments.setCookie",
        "title": "Overleaf Comments: Set Session Cookie"
      },
      {
        "command": "overleafComments.refresh",
        "title": "Overleaf Comments: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "overleafComments.clearCookie",
        "title": "Overleaf Comments: Clear Session Cookie"
      },
      {
        "command": "overleafComments.reply",
        "title": "Reply"
      },
      {
        "command": "overleafComments.resolve",
        "title": "Resolve thread",
        "icon": "$(check)"
      },
      {
        "command": "overleafComments.treeReply",
        "title": "Reply",
        "icon": "$(comment)"
      },
      {
        "command": "overleafComments.treeResolve",
        "title": "Resolve thread",
        "icon": "$(check)"
      },
      {
        "command": "overleafComments.treeReopen",
        "title": "Reopen thread",
        "icon": "$(debug-restart)"
      },
      {
        "command": "overleafComments.treeReveal",
        "title": "Show in editor"
      },
      {
        "command": "overleafComments.close",
        "title": "Close",
        "icon": "$(close)"
      },
      {
        "command": "overleafComments.hoverReply",
        "title": "Overleaf Comments: hoverReply"
      },
      {
        "command": "overleafComments.hoverResolve",
        "title": "Overleaf Comments: hoverResolve"
      },
      {
        "command": "overleafComments.toggleMessage",
        "title": "Overleaf Comments: toggleMessage"
      },
      {
        "command": "overleafComments.showAll",
        "title": "Show entire comments",
        "icon": "$(unfold)"
      },
      {
        "command": "overleafComments.collapseAll",
        "title": "Collapse comments",
        "icon": "$(fold)"
      },
      {
        "command": "overleafComments.showThread",
        "title": "Overleaf Comments: showThread"
      }
    ],
    "configuration": {
      "title": "Overleaf Comments",
      "properties": {
        "overleafComments.projectId": {
          "type": "string",
          "default": "",
          "description": "Overleaf project id. Empty = read it from the git remote (git.overleaf.com/<id>)."
        },
        "overleafComments.baseUrl": {
          "type": "string",
          "default": "https://www.overleaf.com",
          "description": "Overleaf instance URL (self-hosted: your server)."
        },
        "overleafComments.refreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Re-fetch comments when the window regains focus and the last fetch is older than this many minutes. 0 = only on startup and manual refresh."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "overleafComments.reply",
          "when": "false"
        },
        {
          "command": "overleafComments.resolve",
          "when": "false"
        },
        {
          "command": "overleafComments.treeReply",
          "when": "false"
        },
        {
          "command": "overleafComments.treeResolve",
          "when": "false"
        },
        {
          "command": "overleafComments.treeReopen",
          "when": "false"
        },
        {
          "command": "overleafComments.treeReveal",
          "when": "false"
        },
        {
          "command": "overleafComments.close",
          "when": "false"
        },
        {
          "command": "overleafComments.hoverReply",
          "when": "false"
        },
        {
          "command": "overleafComments.hoverResolve",
          "when": "false"
        },
        {
          "command": "overleafComments.toggleMessage",
          "when": "false"
        },
        {
          "command": "overleafComments.showAll",
          "when": "false"
        },
        {
          "command": "overleafComments.collapseAll",
          "when": "false"
        },
        {
          "command": "overleafComments.showThread",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "overleafComments.reply",
          "group": "inline",
          "when": "commentController == overleaf"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "overleafComments.resolve",
          "group": "navigation",
          "when": "commentController == overleaf && commentThread =~ /^open/"
        },
        {
          "command": "overleafComments.close",
          "group": "navigation@9",
          "when": "commentController == overleaf"
        },
        {
          "command": "overleafComments.showAll",
          "group": "navigation@1",
          "when": "commentController == overleaf && commentThread == openLong"
        },
        {
          "command": "overleafComments.collapseAll",
          "group": "navigation@1",
          "when": "commentController == overleaf && commentThread == openLongExpanded"
        }
      ],
      "view/item/context": [
        {
          "command": "overleafComments.treeReply",
          "group": "inline@1",
          "when": "view == overleafComments.threads && viewItem == open"
        },
        {
          "command": "overleafComments.treeResolve",
          "group": "inline@2",
          "when": "view == overleafComments.threads && viewItem == open"
        },
        {
          "command": "overleafComments.treeReopen",
          "group": "inline@1",
          "when": "view == overleafComments.threads && viewItem == resolved"
        }
      ],
      "view/title": [
        {
          "command": "overleafComments.refresh",
          "group": "navigation",
          "when": "view == overleafComments.threads"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overleafComments",
          "title": "Overleaf Comments",
          "icon": "media/comments.svg"
        }
      ]
    },
    "views": {
      "overleafComments": [
        {
          "id": "overleafComments.threads",
          "name": "Threads",
          "when": "overleafComments.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overleafComments.threads",
        "contents": "Not signed in to Overleaf yet.\n[Set Session Cookie](command:overleafComments.setCookie)",
        "when": "!overleafComments.hasCookie"
      },
      {
        "view": "overleafComments.threads",
        "contents": "Could not load comments (offline, or the cookie expired).\n[Refresh](command:overleafComments.refresh)\n[Set Session Cookie](command:overleafComments.setCookie)",
        "when": "overleafComments.hasCookie && overleafComments.loadFailed"
      },
      {
        "view": "overleafComments.threads",
        "contents": "No comments in this project.\n[Refresh](command:overleafComments.refresh)",
        "when": "overleafComments.hasCookie && !overleafComments.loadFailed"
      }
    ],
    "configurationDefaults": {
      "comments.openView": "never",
      "comments.maxHeight": false
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --banner:js=\"const __importMetaUrl=require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__importMetaUrl",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:host": "esbuild test/host/suite.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/host-suite.cjs && node test/host/run.ts",
    "test:live": "esbuild test/host/live.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/host-live.cjs --banner:js=\"const __importMetaUrl=require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__importMetaUrl && node test/host/run.ts",
    "dev": "npm run build && node scripts/dev.mjs"
  },
  "dependencies": {
    "@aloth/olcli": "file:vendor/olcli"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
